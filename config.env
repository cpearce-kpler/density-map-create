# =====================================================================
# AIS raster-density heatmap configuration
# =====================================================================
# This file is intentionally named config.env so it remains visible in GitHub.
# Keep it beside build_ais_heatmap.py.

# ---------------------------------------------------------------------
# Input and output paths
# ---------------------------------------------------------------------
# Forward slashes are easiest to use in Windows paths.
AIS_FOLDER='C:/Users/Craig Pearce/Desktop/Data_sets/ais_files/ais_2025'
VESSEL_CSV='C:/Users/Craig Pearce/Desktop/Data_sets/MT/MT_vessel_data.csv'
OUTPUT_DIR='C:/Users/Craig Pearce/Desktop/ais_heatmap_tiles'

# Leave as None to generate the name from groups, metric, speed and zooms.
OUTPUT_NAME=None

# ---------------------------------------------------------------------
# AIS and vessel metadata column names
# ---------------------------------------------------------------------
SHIP_ID_COLUMN=SHIP_ID
LAT_COLUMN=LAT
LON_COLUMN=LON
SPEED_COLUMN=SPEED
TIMESTAMP_COLUMN=TIMESTAMP

VESSEL_SHIP_ID_COLUMN=SHIP_ID
VESSEL_GROUP_COLUMN=COMFLEET_GROUPEDTYPE

# ---------------------------------------------------------------------
# Vessel selection and density metric
# ---------------------------------------------------------------------
# Use ALL for every vessel, or comma-separate one or more group values.
# Examples:
# GROUPS=ALL
# GROUPS='DRY BULK'
# GROUPS='DRY BULK,TANKERS'
GROUPS='DRY BULK'

# Supported values:
#   track_km     = estimated track kilometres distributed along valid segments
#   vessel_hours = elapsed vessel-hours distributed along valid segments
#   point_count  = count individual qualifying AIS observations in their pixels
#
# point_count is a basic observation-density metric. It can be influenced by
# vessel reporting frequency and does not interpolate between AIS positions.
METRIC=track_km

# The source SPEED column is knots multiplied by this scale.
# The threshold is inclusive: SPEED / SPEED_SCALE >= MIN_SPEED_KNOTS.
# With the defaults, raw SPEED=10 is included and raw SPEED<10 is excluded.
SPEED_SCALE=10.0
MIN_SPEED_KNOTS=1.0

# For track_km and vessel_hours:
#   true  = both endpoints must be at or above MIN_SPEED_KNOTS
#   false = average endpoint speed must be at or above MIN_SPEED_KNOTS
# This setting is ignored for point_count, where each observation is tested.
REQUIRE_BOTH_ENDPOINT_SPEEDS=true

# ---------------------------------------------------------------------
# Zoom range and track quality controls
# ---------------------------------------------------------------------
MIN_ZOOM=0
MAX_ZOOM=11

# These two quality controls apply only to track_km and vessel_hours.
# They are ignored for point_count because no track segments are constructed.
MAX_GAP_MINUTES=60
MAX_IMPLIED_SPEED_KNOTS=80.0

# ---------------------------------------------------------------------
# DuckDB resources and staging sharding
# ---------------------------------------------------------------------
THREADS=4
DUCKDB_MEMORY_LIMIT=32GB
DUCKDB_TEMP_DIR='C:/ais_duckdb_temp'
DUCKDB_PRESERVE_INSERTION_ORDER=false
# Used for SHIP_ID segment shards and point_count staging partitions.
SHIP_ID_SHARDS=8

# ---------------------------------------------------------------------
# Rasterisation and sparse-pixel memory controls
# ---------------------------------------------------------------------
# SAMPLE_STEP_PX and MAX_SEGMENT_SAMPLES apply only to track metrics.
SAMPLE_STEP_PX=3.0
MAX_SEGMENT_SAMPLES=4096

# These apply to both segment and point-count processing.
PIXEL_FLUSH_THRESHOLD=750000
# Despite its historical name, this is also the point batch size for point_count.
SEGMENT_BATCH_SIZE=100000

# ---------------------------------------------------------------------
# Visual heatmap rendering
# ---------------------------------------------------------------------
BLUR_RADIUS=2
COLOUR_QUANTILE=0.995
ALPHA_MIN=25
ALPHA_MAX=230

# ---------------------------------------------------------------------
# Output choices
# ---------------------------------------------------------------------
WRITE_XYZ=true
WRITE_MBTILES=true

# Analytical outputs retain values before colour rendering.
WRITE_VALUE_PIXELS=true
WRITE_VALUE_TIFFS=false
WRITE_VALUE_COMPOSITE_GEOTIFF=true

# Analytical output zoom selection:
#   max       = only MAX_ZOOM
#   all       = every zoom from MIN_ZOOM through MAX_ZOOM
#   9,10,11   = only the listed zooms
#   None      = same behaviour as max
VALUE_OUTPUT_ZOOMS=max

# Optional test cap for TIFF tiles. Use None for no cap.
VALUE_TIFF_TILE_LIMIT=None

# Keep intermediate DuckDB and Parquet work files for debugging.
KEEP_WORK=false
